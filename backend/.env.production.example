# Database - Required
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:postgres@db:5432/jojuhu_backend

# Server
HOST=0.0.0.0
PORT=8080

# JWT - Change this to a secure random string!
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRATION_HOURS=24

# CORS - REQUIRED for production
# Comma-separated list of allowed origins (your frontend domain(s))
# Example: ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# Logging (error, warn, info, debug, trace)
RUST_LOG=info

# Environment
APP_ENVIRONMENT=production
