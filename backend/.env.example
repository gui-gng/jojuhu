# Database
DATABASE_URL=postgres://username:password@localhost:5432/jojuhu_backend

# Server
HOST=127.0.0.1
PORT=8080

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION_HOURS=24

# CORS - comma-separated list of allowed origins
# For development, defaults include common ports (3000, 5000, 8080, 4200)
# For production, set this explicitly to your domain(s)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Environment
RUST_LOG=info
APP_ENVIRONMENT=development
