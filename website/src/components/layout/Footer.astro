---
const footerLinks = {
  product: {
    title: 'Produto',
    links: [
      { label: 'Funcionalidades', href: '/funcionalidades' },
      { label: 'Baixar', href: '/baixar' },
      { label: 'Atualizações', href: '#' },
    ]
  },
  company: {
    title: 'Empresa',
    links: [
      { label: 'Sobre', href: '/sobre' },
      { label: 'Blog', href: '#' },
      { label: 'Carreiras', href: '#' },
    ]
  },
  community: {
    title: 'Comunidade',
    links: [
      { label: 'GitHub', href: 'https://github.com/jojuhu' },
      { label: 'Discord', href: '#' },
      { label: 'Twitter', href: '#' },
    ]
  },
  legal: {
    title: 'Legal',
    links: [
      { label: 'Privacidade', href: '/privacidade' },
      { label: 'Termos', href: '/termos' },
      { label: 'Licença', href: '/licenca' },
    ]
  }
};
---

<footer class="bg-white dark:bg-surface-dark border-t border-gray-200 dark:border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Newsletter -->
    <div class="py-12 border-b border-gray-200 dark:border-gray-800">
      <div class="max-w-xl mx-auto text-center">
        <h3 class="text-2xl font-bold font-display text-texto dark:text-texto-dark mb-3">
          Fique por dentro
        </h3>
        <p class="text-texto-secundario dark:text-gray-400 mb-6">
          Receba novidades, atualizações e histórias da comunidade Jojuhu.
        </p>
        
        <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" onsubmit="event.preventDefault(); alert('Obrigado! Em breve entraremos em contato.');">
          <input 
            type="email" 
            placeholder="seu@email.com"
            class="flex-1 px-4 py-3 rounded-xl bg-fundo dark:bg-fundo-dark border border-gray-200 dark:border-gray-700 text-texto dark:text-texto-dark placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sol/50"
            required
          />
          <button 
            type="submit"
            class="px-6 py-3 bg-sol text-white font-medium rounded-xl hover:bg-sol/90 transition-colors"
          >
            Inscrever
          </button>
        </form>
      </div>
    </div>

    <!-- Links -->
    <div class="py-12 grid grid-cols-2 md:grid-cols-4 gap-8">
      {Object.values(footerLinks).map((section) => (
        <div>
          <h4 class="font-semibold text-texto dark:text-texto-dark mb-4">{section.title}</h4>
          <ul class="space-y-3">
            {section.links.map((link) => (
              <li>
                <a 
                  href={link.href}
                  class="text-texto-secundario dark:text-gray-400 hover:text-sol dark:hover:text-sol transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom -->
    <div class="py-6 border-t border-gray-200 dark:border-gray-800 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <img 
          src="/images/logo-icon.svg" 
          alt="Jojuhu Logo" 
          class="w-8 h-8"
        />
        <span class="font-semibold text-texto dark:text-texto-dark">Jojuhu</span>
      </div>
      
      <p class="text-sm text-texto-secundario dark:text-gray-400 text-center">
        © 2026 Jojuhu. Código aberto sob MIT License.
      </p>
      
      <div class="flex items-center gap-4">
        <a href="#" class="text-texto-secundario hover:text-sol transition-colors" aria-label="GitHub">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        
        <a href="#" class="text-texto-secundario hover:text-sol transition-colors" aria-label="Twitter">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
