---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Funcionalidades', href: '/funcionalidades' },
  { label: 'Sobre', href: '/sobre' },
  { label: 'Baixar', href: '/baixar' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-fundo/80 dark:bg-fundo-dark/80 backdrop-blur-md border-b border-gray-200/50 dark:border-gray-800/50 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <img 
          src="/images/logo-icon.svg" 
          alt="Jojuhu Logo" 
          class="w-10 h-10 transform group-hover:scale-105 transition-transform duration-300"
        />
        <span class="text-xl font-bold font-display text-texto dark:text-texto-dark">Jojuhu</span>
      </a>

      <!-- Navegação Desktop -->
      <nav class="hidden md:flex items-center gap-1">
        {navItems.map((item) => (
          <a 
            href={item.href}
            class="px-4 py-2 text-sm font-medium text-texto-secundario hover:text-sol dark:text-gray-400 dark:hover:text-sol rounded-lg hover:bg-sol/5 transition-colors duration-200"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Ações -->
      <div class="flex items-center gap-3">
        <!-- Toggle Tema -->
        <button 
          id="theme-toggle"
          class="p-2 rounded-lg text-texto-secundario hover:text-sol hover:bg-sol/5 transition-colors"
          aria-label="Alternar tema"
        >
          <svg id="sun-icon" class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg id="moon-icon" class="w-5 h-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- CTA Mobile -->
        <a 
          href="/baixar"
          class="hidden sm:inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-sol rounded-lg hover:bg-sol/90 transition-colors"
        >
          Baixar
        </a>

        <!-- Menu Mobile -->
        <button 
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg text-texto-secundario hover:text-sol hover:bg-sol/5 transition-colors"
          aria-label="Menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menu Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden bg-fundo dark:bg-fundo-dark border-b border-gray-200 dark:border-gray-800">
    <div class="px-4 py-3 space-y-1">
      {navItems.map((item) => (
        <a 
          href={item.href}
          class="block px-3 py-2 text-base font-medium text-texto-secundario hover:text-sol hover:bg-sol/5 rounded-lg transition-colors"
        >
          {item.label}
        </a>
      ))}
      <a 
        href="/baixar"
        class="block px-3 py-2 mt-4 text-base font-medium text-white bg-sol rounded-lg hover:bg-sol/90 text-center"
      >
        Baixar App
      </a>
    </div>
  </div>
</header>

<script>
  // Toggle tema
  const themeToggle = document.getElementById('theme-toggle');
  const html = document.documentElement;
  
  // Verificar preferência salva
  const savedTheme = localStorage.getItem('theme');
  if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    html.classList.add('dark');
  }
  
  themeToggle?.addEventListener('click', () => {
    html.classList.toggle('dark');
    localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
  });

  // Toggle menu mobile
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
