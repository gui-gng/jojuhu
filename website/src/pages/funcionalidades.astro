---
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';

const title = "Funcionalidades - Jojuhu";
const description = "Descubra todas as funcionalidades do Jojuhu: feed inteligente, mensagens, fóruns, stories e muito mais. Tudo com privacidade real.";

const features = [
  {
    icon: "🌊",
    title: "Feed Inteligente",
    description: "Algoritmo que aprende seus interesses sem criar bolhas. Escolha entre ordem cronológica ou personalizada. Você no controle do que vê."
  },
  {
    icon: "💬",
    title: "Mensagens Diretas",
    description: "Conversas privadas sem anúncios. Criptografia ponta a ponta. Chats individuais e em grupo com reações e compartilhamento de mídia."
  },
  {
    icon: "🏛️",
    title: "Fóruns Temáticos",
    description: "Comunidades organizadas por interesse. Discussões profundas, moderação justa, regras claras. Onde ideias fluem naturalmente."
  },
  {
    icon: "⏳",
    title: "Stories Efêmeros",
    description: "Momentos que desaparecem em 24h. Compartilhe o dia a dia sem acumular no perfil. Reações e respostas privadas de amigos."
  },
  {
    icon: "🔄",
    title: "Reposts Criativos",
    description: "Compartilhe com comentário. Dê crédito sempre. Amplifique vozes que importam com contexto e respeito."
  },
  {
    icon: "📴",
    title: "Modo Offline",
    description: "Acesse conteúdo salvo mesmo sem internet. Leia posts, veja mensagens. Conectado, mesmo desconectado."
  }
];

const technologies = [
  { name: "Rust", description: "Backend de alta performance e segurança", color: "#DEA584" },
  { name: "Flutter", description: "Frontend multiplataforma nativo", color: "#02569B" },
  { name: "PostgreSQL", description: "Banco de dados robusto e escalável", color: "#336791" },
  { name: "Redis", description: "Cache em memória para velocidade", color: "#DC382D" },
  { name: "MinIO", description: "Armazenamento de objetos S3-compatible", color: "#C72C48" }
];
---

<Base title={title} description={description}>
  <Header />
  
  <main class="pt-16 md:pt-20">
    
    <!-- HEADER SECTION -->
    <section class="py-20 md:py-32 bg-gradient-to-b from-sol/5 to-transparent">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        
        <span class="inline-block px-4 py-2 rounded-full bg-sol/10 text-sol text-sm font-medium mb-6">
          Funcionalidades
        </span>
        
        <h1 class="text-4xl md:text-6xl font-bold font-display text-texto dark:text-texto-dark mb-6">
          Tudo o que você precisa
          <br />
          <span class="text-sol">para se conectar</span>
        </h1>
        
        <p class="text-lg md:text-xl text-texto-secundario dark:text-gray-400 max-w-2xl mx-auto">
          Sem complexidade, sem manipulação. Ferramentas simples e poderosas 
          para suas conexões mais importantes.
        </p>
      </div>
    </section>

    <!-- FEATURES GRID -->
    <section class="py-20 md:py-32 bg-white dark:bg-surface-dark">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {features.map((feature, index) => (
            <Card 
              key={index} 
              variant="feature" 
              icon={feature.icon}
              class="h-full"
            >
              <h3 class="text-xl font-bold text-texto dark:text-texto-dark mb-3">
                {feature.title}
              </h3>
              <p class="text-texto-secundario dark:text-gray-400 leading-relaxed">
                {feature.description}
              </p>
            </Card>
          ))}
        </div>

      </div>
    </section>

    <!-- TECH STACK SECTION -->
    <section class="py-20 md:py-32 bg-fundo dark:bg-fundo-dark">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-16">
          <span class="inline-block px-4 py-2 rounded-full bg-lua/10 text-lua text-sm font-medium mb-4">
            Tecnologia
          </span>
          
          <h2 class="text-3xl md:text-4xl font-bold font-display text-texto dark:text-texto-dark mb-4">
            Construído com tecnologia de ponta
          </h2>
          
          <p class="text-lg text-texto-secundario dark:text-gray-400 max-w-2xl mx-auto">
            Backend em Rust para performance e segurança máxima. 
            Frontend em Flutter para funcionar perfeitamente em qualquer dispositivo. 
            Código 100% aberto e auditável.
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
          {technologies.map((tech, index) => (
            <div 
              key={index}
              class="bg-white dark:bg-surface-dark rounded-2xl p-6 text-center shadow-lg hover:shadow-xl transition-shadow duration-300 border border-gray-100 dark:border-gray-800"
            >
              <div 
                class="w-16 h-16 mx-auto rounded-xl mb-4 flex items-center justify-center text-2xl font-bold text-white"
                style={`background-color: ${tech.color}`}
              >
                {tech.name.charAt(0)}
              </div>
              <h3 class="font-bold text-texto dark:text-texto-dark mb-2">{tech.name}</h3>
              <p class="text-sm text-texto-secundario dark:text-gray-400">{tech.description}</p>
            </div>
          ))}
        </div>

        <!-- Open Source Badge -->
        <div class="mt-16 text-center">
          <div class="inline-flex items-center gap-3 px-6 py-3 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="font-medium">100% Código Aberto - Auditável por qualquer pessoa</span>
          </div>
        </div>

      </div>
    </section>

    <!-- COMPARISON SECTION (Opcional) -->
    <section class="py-20 md:py-32 bg-white dark:bg-surface-dark">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold font-display text-texto dark:text-texto-dark mb-4">
            A diferença é clara
          </h2>
          <p class="text-lg text-texto-secundario dark:text-gray-400">
            Veja o que nos diferencia das redes tradicionais
          </p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b-2 border-gray-200 dark:border-gray-700">
                <th class="text-left py-4 px-4 font-semibold text-texto dark:text-texto-dark">Característica</th>
                <th class="text-center py-4 px-4 font-semibold text-sol">Jojuhu</th>
                <th class="text-center py-4 px-4 font-semibold text-texto-secundario dark:text-gray-400">Redes Tradicionais</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
              {[
                { feature: "Código aberto", jojuhu: "✅ Sim", others: "❌ Não" },
                { feature: "Algoritmo transparente", jojuhu: "✅ Sim", others: "❌ Não" },
                { feature: "Sem rastreamento", jojuhu: "✅ Sim", others: "❌ Não" },
                { feature: "Dados portáteis", jojuhu: "✅ Sim", others: "⚠️ Parcial" },
                { feature: "Sem anúncios", jojuhu: "✅ Sim", others: "❌ Não" },
                { feature: "Moderação justa", jojuhu: "✅ Sim", others: "⚠️ Variável" },
              ].map((row, index) => (
                <tr key={index} class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                  <td class="py-4 px-4 text-texto dark:text-texto-dark">{row.feature}</td>
                  <td class="py-4 px-4 text-center font-medium text-green-600 dark:text-green-400">{row.jojuhu}</td>
                  <td class="py-4 px-4 text-center text-texto-secundario dark:text-gray-400">{row.others}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

      </div>
    </section>

    <!-- CTA SECTION -->
    <section class="py-20 md:py-32 bg-gradient-to-br from-sol to-lua text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        
        <h2 class="text-3xl md:text-5xl font-bold font-display mb-6">
          Experimente agora
        </h2>
        
        <p class="text-lg md:text-xl text-white/80 mb-10 max-w-2xl mx-auto">
          É gratuito e sempre será. Sem custos ocultos, sem venda de dados. 
          Uma rede social feita por pessoas, para pessoas.
        </p>

        <Button 
          href="/baixar" 
          variant="primary" 
          size="lg"
          class="bg-white text-sol hover:bg-white/90 shadow-xl"
        >
          Baixar Jojuhu
        </Button>

      </div>
    </section>

  </main>

  <Footer />

</Base>
