---
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';

const title = "Jojuhu - Rede Social que Celebra Quem Você É";
const description = "Onde correntes distintas criam algo maior. Conecte-se autenticamente com privacidade real e código aberto.";
---

<Base title={title} description={description}>
  <Header />
  
  <main class="pt-16 md:pt-20">
    
    <!-- HERO SECTION -->
    <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
      <!-- Background Gradient -->
      <div class="absolute inset-0 animate-water-flow opacity-90"></div>
      
      <!-- Noise overlay -->
      <div class="absolute inset-0 opacity-20" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>
      
      <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <!-- Logo animado -->
        <div class="mb-8 animate-float">
          <div class="w-24 h-24 md:w-32 md:h-32 mx-auto rounded-3xl bg-white/20 backdrop-blur-sm flex items-center justify-center shadow-2xl p-4">
            <img 
              src="/images/logo-icon.svg" 
              alt="Jojuhu Logo" 
              class="w-full h-full"
            />
          </div>
        </div>
        
        <!-- Headline -->
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold font-display text-white mb-6 leading-tight">
          Onde correntes distintas
          <br />
          <span class="text-white/90">criam algo maior</span>
        </h1>
        
        <!-- Subheadline -->
        <p class="text-lg md:text-xl text-white/80 max-w-2xl mx-auto mb-10">
          Jojuhu é a rede social que celebra quem você é. Conecte-se de forma autêntica, 
          sem algoritmos manipulativos, com privacidade real e código aberto.
        </p>
        
        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/baixar" variant="primary" size="lg" class="w-full sm:w-auto bg-white text-sol hover:bg-white/90 shadow-xl">
            <span class="mr-2">📱</span> Baixar App
          </Button>
          
          <Button href="#manifesto" variant="outline" size="lg" class="w-full sm:w-auto border-white text-white hover:bg-white/10">
            Conheça Mais
          </Button>
        </div>
      </div>
      
      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
        <svg class="w-6 h-6 text-white/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </section>

    <!-- MANIFESTO SECTION -->
    <section id="manifesto" class="py-20 md:py-32 bg-fundo dark:bg-fundo-dark">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        
        <div class="mb-8">
          <span class="inline-block px-4 py-2 rounded-full bg-sol/10 text-sol text-sm font-medium mb-6">
            Nosso Manifesto
          </span>
        </div>
        
        <blockquote class="relative">
          <div class="absolute -top-4 -left-4 text-8xl text-sol/20 font-display">""""</div>
          
          <p class="relative text-2xl md:text-3xl lg:text-4xl font-medium font-display text-texto dark:text-texto-dark leading-relaxed mb-8">
            Aqui, cada pessoa é uma <span class="text-sol">corrente única</span> — com sua temperatura, 
            seu ritmo, sua essência. Não nos misturamos para nos perdermos. 
            Flutuamos lado a lado, respeitando fronteiras, até que, naturalmente, 
            algo maior emerge: <span class="text-lua">conexões autênticas</span>, ideias que só existem 
            quando correntes distintas se tocam.
          </p>
          
          <div class="absolute -bottom-4 -right-4 text-8xl text-lua/20 font-display rotate-180">""""</div>
        </blockquote>
        
        <div class="mt-12">
          <div class="flex items-center justify-center gap-4">
            <div class="h-px w-16 bg-gradient-to-r from-transparent to-sol"></div>
            <span class="text-texto-secundario dark:text-gray-400">Jojuhu</span>
            <div class="h-px w-16 bg-gradient-to-l from-transparent to-lua"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- DIFERENCIAIS SECTION -->
    <section class="py-20 md:py-32 bg-white dark:bg-surface-dark">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-16">
          <span class="inline-block px-4 py-2 rounded-full bg-lua/10 text-lua text-sm font-medium mb-4">
            Por que Jojuhu?
          </span>
          <h2 class="text-3xl md:text-5xl font-bold font-display text-texto dark:text-texto-dark mb-4">
            Diferente de propósito
          </h2>
          <p class="text-lg text-texto-secundario dark:text-gray-400 max-w-2xl mx-auto">
            Reimaginamos o que uma rede social pode ser quando colocamos pessoas 
            antes de algoritmos.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          
          <!-- Card 1 -->
          <Card variant="feature" icon="💙">
            <h3 class="text-xl font-bold text-texto dark:text-texto-dark mb-3">
              Conexões Autênticas
            </h3>
            <p class="text-texto-secundario dark:text-gray-400 leading-relaxed">
              Algoritmos transparentes que valorizam relevância, não vício. 
              Você vê o que importa, não o que engaja artificialmente.
            </p>
          </Card>

          <!-- Card 2 -->
          <Card variant="feature" icon="👥">
            <h3 class="text-xl font-bold text-texto dark:text-texto-dark mb-3">
              Comunidades Vivas
            </h3>
            <p class="text-texto-secundario dark:text-gray-400 leading-relaxed">
              Fóruns e grupos onde ideias fluem naturalmente, sem competição 
              por likes. Conversas que enriquecem, não competem.
            </p>
          </Card>

          <!-- Card 3 -->
          <Card variant="feature" icon="🔒">
            <h3 class="text-xl font-bold text-texto dark:text-texto-dark mb-3">
              Privacidade Real
            </h3>
            <p class="text-texto-secundario dark:text-gray-400 leading-relaxed">
              Seus dados são seus. Código aberto para auditoria. 
              Sem rastreamento oculto, sem vendas de informações.
            </p>
          </Card>

        </div>
      </div>
    </section>

    <!-- CTA FINAL SECTION -->
    <section class="py-20 md:py-32 bg-gradient-to-br from-sol/5 via-encontro/5 to-lua/5 dark:from-sol/10 dark:via-encontro/10 dark:to-lua/10">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        
        <h2 class="text-3xl md:text-5xl font-bold font-display text-texto dark:text-texto-dark mb-6">
          Pronto para encontrar sua corrente?
        </h2>
        
        <p class="text-lg md:text-xl text-texto-secundario dark:text-gray-400 mb-10 max-w-2xl mx-auto">
          Junte-se a milhares de pessoas que escolheram uma rede social mais 
          humana, autêntica e respeitosa.
        </p>

        <!-- Newsletter -->
        <form class="max-w-md mx-auto mb-12" onsubmit="event.preventDefault(); alert('Obrigado pelo interesse! Em breve entraremos em contato.');">
          <div class="flex flex-col sm:flex-row gap-3">
            <input 
              type="email" 
              placeholder="Digite seu email"
              class="flex-1 px-5 py-4 rounded-xl bg-white dark:bg-fundo-dark border border-gray-200 dark:border-gray-700 text-texto dark:text-texto-dark placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sol/50"
              required
            />
            
            <button 
              type="submit"
              class="px-8 py-4 bg-sol text-white font-semibold rounded-xl hover:bg-sol/90 transition-colors shadow-lg shadow-sol/25"
            >
              Quero fazer parte
            </button>
          </div>
          
          <p class="text-sm text-texto-secundario dark:text-gray-500 mt-3">
            Sem spam. Cancele quando quiser.
          </p>
        </form>

        <!-- Download buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="#" variant="secondary" size="md" class="w-full sm:w-auto">
            <span class="mr-2">🍎</span> App Store
          </Button>
          
          <Button href="#" variant="secondary" size="md" class="w-full sm:w-auto bg-encontro hover:bg-encontro/90">
            <span class="mr-2">🤖</span> Google Play
          </Button>
          
          <Button href="#" variant="outline" size="md" class="w-full sm:w-auto">
            <span class="mr-2">🌐</span> Versão Web
          </Button>
        </div>

      </div>
    </section>

  </main>

  <Footer />

</Base>

<script>
  // Animação suave ao clicar em âncoras
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });

  // Observer para animações de entrada
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-fade-in-up');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  // Observar cards e seções
  document.querySelectorAll('.card-hover, section > div').forEach((el) => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(30px)';
    observer.observe(el);
  });
</script>
