---
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';

const title = "Sobre - Jojuhu";
const description = "Conheça a história do Jojuhu. Nascemos do Encontro das Águas na Amazônia. Código aberto, privacidade real, comunidade autêntica.";

const values = [
  {
    icon: "💝",
    title: "Autenticidade",
    description: "Seja quem você é. Sem filtros algorítmicos forçando você a postar de certa forma. Expressão genuína, sempre."
  },
  {
    icon: "🛡️",
    title: "Respeito",
    description: "Fronteiras claras. Consentimento sempre. Ferramentas de moderação que protegem sem silenciar."
  },
  {
    icon: "🤝",
    title: "Comunidade",
    description: "Conexões que enriquecem, não competem. Celebramos diferenças. Crescemos juntos, não uns sobre os outros."
  },
  {
    icon: "👁️",
    title: "Transparência",
    description: "Código aberto. Decisões claras. Algoritmos explicados. Você merece saber como as coisas funcionam."
  }
];

const team = [
  {
    name: "Fundador",
    role: "Criador & Desenvolvedor",
    bio: "Apaixonado por código aberto e comunidades saudáveis. Acredita que tecnologia deve servir pessoas, não o contrário."
  }
];
---

<Base title={title} description={description}>
  <Header />
  
  <main class="pt-16 md:pt-20">
    
    <!-- ORIGIN SECTION -->
    <section class="py-20 md:py-32 bg-gradient-to-b from-lua/5 to-transparent">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-2 rounded-full bg-lua/10 text-lua text-sm font-medium mb-6">
            Nossa História
          </span>
          
          <h1 class="text-4xl md:text-6xl font-bold font-display text-texto dark:text-texto-dark">
            Nascemos do
            <span class="block text-transparent bg-clip-text bg-gradient-to-r from-sol via-encontro to-lua">
              Encontro das Águas
            </span>
          </h1>
        </div>

        <div class="prose prose-lg dark:prose-invert mx-auto">
          <p class="text-xl leading-relaxed text-texto dark:text-texto-dark">
            <strong class="text-sol">Jojuhu</strong> vem do Tupi-Guarani: 
            <em>encontrar-se, reunir-se</em>.
          </p>
          
          <p class="text-texto-secundario dark:text-gray-400 leading-relaxed">
            É o mesmo mistério que transforma o Rio Negro e o Solimões em espetáculo 
            na Amazônia: a beleza de ser diferente e, ainda assim, seguir junto.
          </p>
          
          <div class="my-12 p-8 bg-gradient-to-r from-sol/5 via-encontro/5 to-lua/5 rounded-2xl border border-encontro/20">
            <blockquote class="text-xl md:text-2xl font-medium font-display text-texto dark:text-texto-dark text-center italic">
              "Criamos esta rede porque acreditamos que tecnologia deve aproximar, não viciar. 
              Que conexões autênticas são mais valiosas que engajamento vazio. 
              Que cada pessoa merece ser vista como é — única, complexa, digna de respeito."
            </blockquote>
          </div>

        </div>

      </div>
    </section>

    <!-- VALUES SECTION -->
    <section class="py-20 md:py-32 bg-white dark:bg-surface-dark">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-16">
          <span class="inline-block px-4 py-2 rounded-full bg-encontro/10 text-encontro text-sm font-medium mb-4">
            Nossos Valores
          </span>
          
          <h2 class="text-3xl md:text-5xl font-bold font-display text-texto dark:text-texto-dark mb-4">
            O que nos guia
          </h2>
          <p class="text-lg text-texto-secundario dark:text-gray-400 max-w-2xl mx-auto">
            Quatro pilares que sustentam cada decisão que tomamos
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {values.map((value, index) => (
            <Card key={index} variant="feature" icon={value.icon}>
              <h3 class="text-2xl font-bold text-texto dark:text-texto-dark mb-3">
                {value.title}
              </h3>
              <p class="text-texto-secundario dark:text-gray-400 leading-relaxed">
                {value.description}
              </p>
            </Card>
          ))}
        </div>

      </div>
    </section>

    <!-- OPEN SOURCE SECTION -->
    <section class="py-20 md:py-32 bg-fundo dark:bg-fundo-dark">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          
          <div>
            <span class="inline-block px-4 py-2 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-sm font-medium mb-6">
              Código Aberto
            </span>
            
            <h2 class="text-3xl md:text-4xl font-bold font-display text-texto dark:text-texto-dark mb-6">
              Jojuhu é de todos
            </h2>
            
            <p class="text-lg text-texto-secundario dark:text-gray-400 mb-6 leading-relaxed">
              Nosso código está no GitHub. Qualquer um pode auditar, contribuir ou 
              criar sua própria instância. Acreditamos na democratização da tecnologia social.
            </p>
            
            <p class="text-texto-secundario dark:text-gray-400 mb-8">
              Não há segredos, não há trapaças. Tudo transparente, tudo verificável.
            </p>

            <Button 
              href="https://github.com/jojuhu" 
              variant="secondary" 
              size="md"
              class="inline-flex items-center"
            >
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              Ver no GitHub
            </Button>
          </div>

          <!-- Stats -->
          <div class="grid grid-cols-3 gap-6">
            {[
              { label: "Estrelas", value: "⭐", subtext: "Aguardando..." },
              { label: "Contribuidores", value: "👥", subtext: "Aguardando..." },
              { label: "Commits", value: "💻", subtext: "Aguardando..." },
            ].map((stat, index) => (
              <div key={index} class="bg-white dark:bg-surface-dark rounded-2xl p-6 text-center shadow-lg">
                <div class="text-4xl mb-2">{stat.value}</div>
                <div class="font-bold text-texto dark:text-texto-dark mb-1">{stat.label}</div>
                <div class="text-sm text-texto-secundario dark:text-gray-400">{stat.subtext}</div>
              </div>
            ))}
          </div>

        </div>

      </div>
    </section>

    <!-- TEAM SECTION -->
    <section class="py-20 md:py-32 bg-white dark:bg-surface-dark">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-16">
          <span class="inline-block px-4 py-2 rounded-full bg-sol/10 text-sol text-sm font-medium mb-4">
            Quem Somos
          </span>
          
          <h2 class="text-3xl md:text-5xl font-bold font-display text-texto dark:text-texto-dark mb-4">
            Um time apaixonado
          </h2>
          <p class="text-lg text-texto-secundario dark:text-gray-400">
            Por tecnologia e conexões humanas
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {team.map((member, index) => (
            <div key={index} class="bg-fundo dark:bg-fundo-dark rounded-2xl p-8 text-center">
              <div class="w-24 h-24 mx-auto rounded-full bg-white dark:bg-surface-dark p-2 mb-6 shadow-lg">
                <img 
                  src="/images/logo-icon.svg" 
                  alt="Avatar" 
                  class="w-full h-full rounded-full"
                />
              </div>
              <h3 class="text-xl font-bold text-texto dark:text-texto-dark mb-1">{member.name}</h3>
              <p class="text-sol font-medium mb-4">{member.role}</p>
              <p class="text-texto-secundario dark:text-gray-400 text-sm">{member.bio}</p>
            </div>
          ))}
          
          <!-- CTA para contribuidores -->
          <div class="bg-gradient-to-br from-sol/10 via-encontro/10 to-lua/10 rounded-2xl p-8 text-center border-2 border-dashed border-encontro/30 flex flex-col items-center justify-center">
            <div class="text-4xl mb-4">🚀</div>
            <h3 class="text-xl font-bold text-texto dark:text-texto-dark mb-2">Quer contribuir?</h3>
            <p class="text-texto-secundario dark:text-gray-400 text-sm mb-6">
              Desenvolvedores, designers, tradutores e entusiastas são bem-vindos.
            </p>
            
            <Button href="https://github.com/jojuhu" variant="outline" size="sm">
              Junte-se a nós
            </Button>
          </div>
        </div>

      </div>
    </section>

    <!-- CTA SECTION -->
    <section class="py-20 md:py-32 bg-gradient-to-br from-lua to-encontro text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        
        <h2 class="text-3xl md:text-5xl font-bold font-display mb-6">
          Faça parte da mudança
        </h2>
        
        <p class="text-lg md:text-xl text-white/80 mb-10 max-w-2xl mx-auto">
          Ajude-nos a construir uma internet mais humana, uma conexão de cada vez.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/baixar" variant="primary" size="lg" class="bg-white text-lua hover:bg-white/90">
            Começar a usar
          </Button>
          
          <Button href="https://github.com/jojuhu" variant="outline" size="lg" class="border-white text-white hover:bg-white/10">
            Contribuir no GitHub
          </Button>
        </div>

      </div>
    </section>

  </main>

  <Footer />

</Base>
